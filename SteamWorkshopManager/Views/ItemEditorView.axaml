<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WorkshopManager.ViewModels"
             xmlns:editor="using:WorkshopManager.ViewModels.Editor"
             xmlns:workshop="using:WorkshopManager.Core.Workshop"
             xmlns:models="using:WorkshopManager.Models"
             xmlns:helpers="using:WorkshopManager.Helpers"
             xmlns:converters="using:WorkshopManager.Converters"
             xmlns:controls="using:WorkshopManager.Views.Controls"
             xmlns:sections="using:WorkshopManager.Views.Editor"
             xmlns:behaviors="using:WorkshopManager.Behaviors"
             xmlns:icons="using:Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="WorkshopManager.Views.ItemEditorView"
             x:DataType="vm:ItemEditorViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://WorkshopManager/Themes/EditorStyles.axaml"/>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">
        <!-- Side-panel shell: 240px left nav + right content pane -->
        <Grid Grid.Row="0" ColumnDefinitions="240,*" Margin="24,16">

            <!-- LEFT: section nav -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,16,0"
                    VerticalAlignment="Top">
                <StackPanel Spacing="2">

                    <!-- Mod ID badge: read-only with copy-to-clipboard. Sits
                         above the section nav so it's always visible without
                         needing to hunt for it in the editor body. -->
                    <Grid ColumnDefinitions="*,Auto" Margin="4,2,4,8" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="ID"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding ModId}"
                                       FontFamily="Consolas,Menlo,monospace"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding ModId}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding CopyModIdCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6"
                                ToolTip.Tip="{DynamicResource Copy}">
                            <Panel>
                                <icons:MaterialIcon Kind="ContentCopy" Width="14" Height="14"
                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                    IsVisible="{Binding !IsModIdCopied}"/>
                                <icons:MaterialIcon Kind="Check" Width="14" Height="14"
                                                    Foreground="{DynamicResource FeedbackSuccessBrush}"
                                                    IsVisible="{Binding IsModIdCopied}"/>
                            </Panel>
                        </Button>
                    </Grid>
                    <Border Height="1"
                            Background="{DynamicResource BorderSubtleBrush}"
                            Margin="4,0,4,6"/>

                    <Button Classes="nav-item"
                            Classes.active="{Binding IsInfoActive}"
                            Command="{Binding NavigateToInfoCommand}"
                            HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <icons:MaterialIcon Grid.Column="0" Kind="InformationOutline" Width="16" Height="16"/>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                       Text="{DynamicResource InfoTab}" VerticalAlignment="Center"/>
                            <!-- Green check when complete, red ! pill when required-fields missing -->
                            <icons:MaterialIcon Grid.Column="2" Kind="Check" Width="16" Height="16"
                                                Foreground="{DynamicResource FeedbackSuccessBrush}"
                                                IsVisible="{Binding IsInfoComplete}"/>
                            <Border Grid.Column="2"
                                    Background="{DynamicResource FeedbackDangerBrush}"
                                    CornerRadius="10" Padding="6,1" MinWidth="18"
                                    IsVisible="{Binding !IsInfoComplete}">
                                <TextBlock Text="!" Foreground="White"
                                           FontSize="10" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button Classes="nav-item"
                            Classes.active="{Binding IsChangelogActive}"
                            Command="{Binding NavigateToChangelogCommand}"
                            HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <icons:MaterialIcon Grid.Column="0" Kind="NoteTextOutline" Width="16" Height="16"/>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                       Text="{DynamicResource ChangelogTab}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="nav-item"
                            Classes.active="{Binding IsVersionsActive}"
                            Command="{Binding NavigateToVersionsCommand}"
                            HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <icons:MaterialIcon Grid.Column="0" Kind="SourceBranch" Width="16" Height="16"/>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                       Text="{DynamicResource VersionsTab}" VerticalAlignment="Center"/>
                            <icons:MaterialIcon Grid.Column="2" Kind="Check" Width="16" Height="16"
                                                Foreground="{DynamicResource FeedbackSuccessBrush}"
                                                IsVisible="{Binding IsVersionsComplete}"/>
                            <Border Grid.Column="2"
                                    Background="{DynamicResource FeedbackDangerBrush}"
                                    CornerRadius="10" Padding="6,1" MinWidth="18"
                                    IsVisible="{Binding Versions.IsBranchRangeInvalid}">
                                <TextBlock Text="!" Foreground="White"
                                           FontSize="10" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button Classes="nav-item"
                            Classes.active="{Binding IsHistoryActive}"
                            Command="{Binding NavigateToHistoryCommand}"
                            HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <icons:MaterialIcon Grid.Column="0" Kind="History" Width="16" Height="16"/>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                       Text="{DynamicResource History}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="nav-item"
                            Classes.active="{Binding IsDependenciesActive}"
                            Command="{Binding NavigateToDependenciesCommand}"
                            HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <icons:MaterialIcon Grid.Column="0" Kind="LinkVariant" Width="16" Height="16"/>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                       Text="{DynamicResource Dependencies}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="nav-item"
                            Classes.active="{Binding IsPreviewsActive}"
                            Command="{Binding NavigateToPreviewsCommand}"
                            HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <icons:MaterialIcon Grid.Column="0" Kind="ImageMultipleOutline" Width="16" Height="16"/>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                       Text="{DynamicResource PreviewsTab}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Classes="nav-item"
                            Classes.active="{Binding IsTranslationsActive}"
                            Command="{Binding NavigateToTranslationsCommand}"
                            HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <icons:MaterialIcon Grid.Column="0" Kind="Translate" Width="16" Height="16"/>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                       Text="{DynamicResource TranslationsTab}" VerticalAlignment="Center"/>
                            <!-- Number of languages translated on Steam -->
                            <Border Grid.Column="2"
                                    Background="{DynamicResource SurfaceOverlayBrush}"
                                    CornerRadius="10" Padding="6,1" MinWidth="18"
                                    IsVisible="{Binding Translations.HasTranslations}">
                                <TextBlock Text="{Binding Translations.TranslatedCount}"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Separator -->
                    <Border Height="1"
                            Background="{DynamicResource BorderSubtleBrush}"
                            Margin="4,10,4,8"/>

                    <!-- Primary action: save changes -->
                    <Button Command="{Binding SaveCommand}"
                            IsEnabled="{Binding !IsSaving}"
                            Background="{DynamicResource AccentPrimaryGradientBrush}"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            CornerRadius="8"
                            Padding="12,10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <icons:MaterialIcon Kind="ContentSaveOutline" Width="14" Height="14"/>
                            <TextBlock Text="{DynamicResource Saving}"
                                       IsVisible="{Binding IsSaving}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource SaveChanges}"
                                       IsVisible="{Binding !IsSaving}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Save waits until the cached data is confirmed by Steam -->
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                HorizontalAlignment="Center"
                                Margin="0,6,0,0"
                                IsVisible="{Binding IsCheckingSteam}">
                        <Border Classes="refresh-badge active"
                                Width="16" Height="16" Margin="0"
                                Background="Transparent"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <icons:MaterialIcon Kind="Sync" Width="12" Height="12"
                                                Foreground="{DynamicResource TextMutedBrush}"/>
                        </Border>
                        <TextBlock Text="{DynamicResource SaveWaitsForSteam}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Danger action: delete -->
                    <Button Command="{Binding ShowDeleteDialogCommand}"
                            IsEnabled="{Binding !IsDeleting}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            Foreground="{DynamicResource FeedbackDangerTextBrush}"
                            CornerRadius="8"
                            Padding="12,8"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <icons:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14"/>
                            <TextBlock Text="{DynamicResource Delete}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- RIGHT: section content (only one visible at a time) -->
            <Grid Grid.Column="1">
                <ScrollViewer IsVisible="{Binding IsInfoActive}">
                    <StackPanel Spacing="14" Margin="0,20">

                        <!-- Panel header -->
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Classes="panel-title" Text="{DynamicResource ModInformation}"/>
                            <TextBlock Classes="panel-sub" Text="{DynamicResource ModInformationSub}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- ── Card: Preview image ── -->
                        <Border Classes="section-card">
                            <StackPanel>
                                <Grid Margin="16,14,16,12" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="card-title" Text="{DynamicResource PreviewImage}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Classes="card-meta"
                                               Text="{DynamicResource PreviewImageMeta}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}"/>
                                <Grid Margin="16" ColumnDefinitions="160,*">
                                    <Border Width="160" Height="75"
                                            Background="{DynamicResource SurfaceElevatedBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6" ClipToBounds="True">
                                        <Panel>
                                            <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"
                                                   IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            <icons:MaterialIcon Kind="ImageOutline" Width="22" Height="22"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Opacity="0.3"
                                                                Foreground="{DynamicResource TextMutedBrush}"
                                                                IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNull}}"/>
                                        </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="10">
                                        <TextBlock Text="{Binding PreviewImagePath}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="13"
                                                   IsVisible="{Binding PreviewImagePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Text="{DynamicResource NoImageSelected}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="13"
                                                   IsVisible="{Binding PreviewImagePath, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                        <Grid>
                                            <TextBlock Text="{Binding PreviewImageSize}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="11"
                                                       IsVisible="{Binding !IsImageSizeChanged}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                        IsVisible="{Binding IsImageSizeChanged}">
                                                <TextBlock Text="{Binding OriginalImageSizeDisplay}"
                                                           Foreground="{DynamicResource FeedbackDangerTextBrush}"
                                                           TextDecorations="Strikethrough"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>
                                                <icons:MaterialIcon Kind="ArrowRight" Width="11" Height="11"
                                                                    Foreground="{DynamicResource TextMutedBrush}"
                                                                    VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PreviewImageSize}"
                                                           Foreground="{DynamicResource FeedbackSuccessTextBrush}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Background="#1FC23B2E" Padding="8" CornerRadius="4"
                                                BorderBrush="{DynamicResource FeedbackDangerBrush}" BorderThickness="1"
                                                IsVisible="{Binding IsImageTooLarge}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <icons:MaterialIcon Kind="AlertCircleOutline" Width="14" Height="14"
                                                                    Foreground="{DynamicResource FeedbackDangerTextBrush}"
                                                                    VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource ImageTooLarge}"
                                                           Foreground="{DynamicResource FeedbackDangerTextBrush}" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                        <Button Command="{Binding BrowsePreviewImageCommand}"
                                                Background="{DynamicResource SurfaceElevatedBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                CornerRadius="6"
                                                Padding="12,6"
                                                FontSize="13"
                                                HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <icons:MaterialIcon Kind="ImageOutline" Width="14" Height="14"/>
                                                <TextBlock Text="{DynamicResource ChooseImage}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── Card: Details ── -->
                        <Border Classes="section-card">
                            <StackPanel>
                                <Grid Margin="16,14,16,12" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="card-title" Text="{DynamicResource Details}"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}"/>
                                <StackPanel Margin="16" Spacing="16">

                                    <!-- Title -->
                                    <StackPanel>
                                        <TextBlock Classes="field-label" Text="{DynamicResource Title}"/>
                                        <TextBox Text="{Binding Title}" MaxLength="128"
                                                 PlaceholderText="{DynamicResource TitlePlaceholder}"/>
                                    </StackPanel>

                                    <!-- Description (BBCode) -->
                                    <StackPanel>
                                        <TextBlock Classes="field-label" Text="{DynamicResource Description}"/>
                                        <controls:MarkupEditorControl Text="{Binding Description}"
                                                                      EditorHeight="150"
                                                                      PlaceholderText="{DynamicResource DescriptionPlaceholder}"/>
                                    </StackPanel>

                                    <!-- Content folder -->
                                    <StackPanel>
                                        <TextBlock Classes="field-label" Text="{DynamicResource ContentFolder}"/>
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBox Text="{Binding ContentFolderPath}" IsReadOnly="True"
                                                     PlaceholderText="{DynamicResource ContentFolderPlaceholder}"/>
                                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding ContentFolderSize}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="12"
                                                           IsVisible="{Binding !IsFolderSizeChanged}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                            IsVisible="{Binding IsFolderSizeChanged}">
                                                    <TextBlock Text="{Binding OriginalFolderSizeDisplay}"
                                                               Foreground="{DynamicResource FeedbackDangerTextBrush}"
                                                               TextDecorations="Strikethrough"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"/>
                                                    <icons:MaterialIcon Kind="ArrowRight" Width="12" Height="12"
                                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                                        VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ContentFolderSize}"
                                                               Foreground="{DynamicResource FeedbackSuccessTextBrush}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            <Button Grid.Column="2" Command="{Binding BrowseContentFolderCommand}"
                                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    CornerRadius="6"
                                                    Padding="12,6"
                                                    FontSize="13"
                                                    Margin="12,0,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <icons:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14"/>
                                                    <TextBlock Text="{DynamicResource Browse}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Visibility -->
                                    <StackPanel>
                                        <TextBlock Classes="field-label" Text="{DynamicResource Visibility}"/>
                                        <ComboBox ItemsSource="{Binding VisibilityOptions}"
                                                  SelectedItem="{Binding Visibility}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:VisibilityType">
                                                    <TextBlock Text="{Binding Converter={x:Static converters:VisibilityTypeConverter.Instance}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <sections:TagsCardView DataContext="{Binding Tags}"/>

                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding IsChangelogActive}">
                    <StackPanel Spacing="14" Margin="0,20">

                        <!-- Panel header -->
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Classes="panel-title" Text="{DynamicResource UpdateNotes}"/>
                            <TextBlock Classes="panel-sub" Text="{DynamicResource ChangelogInfo}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- ── Card: Update notes ── -->
                        <Border Classes="section-card">
                            <StackPanel>
                                <Grid Margin="16,14,16,12" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="card-title" Text="{DynamicResource UpdateNotes}"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}"/>
                                <StackPanel Margin="16">
                                    <controls:MarkupEditorControl Text="{Binding NewChangelog}"
                                                                  EditorHeight="200"
                                                                  PlaceholderText="{DynamicResource ChangelogPlaceholder}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding IsVersionsActive}">
                    <StackPanel Spacing="14" Margin="0,20">

                        <!-- Panel header -->
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Classes="panel-title" Text="{DynamicResource VersionsHeader}"/>
                            <TextBlock Classes="panel-sub" Text="{DynamicResource VersionsHeaderSub}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ProgressBar IsIndeterminate="True"
                                     IsVisible="{Binding Versions.IsLoadingVersions}"
                                     Height="4"/>

                        <!-- Versioning not enabled banner -->
                        <Border Classes="section-card" IsVisible="{Binding !Versions.IsVersioningEnabled}">
                            <StackPanel Margin="16" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <icons:MaterialIcon Kind="InformationOutline" Width="18" Height="18"
                                                        Foreground="{DynamicResource AccentPrimaryBrush}"
                                                        VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource VersioningNotEnabled}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource VersioningNotEnabledHint}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <!-- ── Card: Existing versions ── -->
                        <Border Classes="section-card" IsVisible="{Binding Versions.IsVersioningEnabled}">
                            <StackPanel>
                                <Grid Margin="16,14,16,12" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="card-title" Text="{DynamicResource ExistingVersions}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Classes="card-meta" VerticalAlignment="Center">
                                        <Run Text="{Binding Versions.ExistingVersions.Count}"/>
                                        <Run Text=" version(s)"/>
                                    </TextBlock>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}"/>
                                <StackPanel Margin="16" Spacing="8">
                                    <TextBlock Text="{DynamicResource NoVersionsYet}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Margin="0,8"
                                               IsVisible="{Binding !Versions.ExistingVersions.Count}"/>
                                    <ItemsControl ItemsSource="{Binding Versions.ExistingVersions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:ModVersionInfo">
                                                <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10,8" Margin="0,0,0,4">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <TextBlock Text="{Binding VersionIndex, StringFormat='#{0}'}"
                                                                   Foreground="{DynamicResource TextDisabledBrush}"
                                                                   FontFamily="Consolas, Menlo, monospace"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding RangeDisplay}"
                                                                   FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Panel IsVisible="{Binding Versions.IsVersioningEnabled}">
                            <sections:VersionCompatibilityView DataContext="{Binding Versions}" ShowContentRequiredNote="True"/>
                        </Panel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding IsHistoryActive}">
                    <StackPanel Spacing="14" Margin="0,20">

                        <!-- Panel header -->
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Classes="panel-title" Text="{DynamicResource History}"/>
                            <TextBlock Classes="panel-sub" Text="{DynamicResource HistorySubtitle}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- ── Card: History entries ── -->
                        <Border Classes="section-card">
                            <StackPanel>
                                <Grid Margin="16,14,16,12" ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Classes="card-title" Text="{DynamicResource PreviousUpdates}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Command="{Binding History.LoadChangelogHistoryCommand}"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            CornerRadius="6"
                                            Padding="10,5"
                                            FontSize="12"
                                            Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <icons:MaterialIcon Kind="Refresh" Width="12" Height="12"/>
                                            <TextBlock Text="{DynamicResource Refresh}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2"
                                            Command="{Binding History.OpenChangelogInBrowserCommand}"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            CornerRadius="6"
                                            Padding="10,5"
                                            FontSize="12">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <icons:MaterialIcon Kind="OpenInNew" Width="12" Height="12"/>
                                            <TextBlock Text="{DynamicResource OpenInBrowser}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}"/>
                                <StackPanel Margin="16" Spacing="10">
                                    <ProgressBar IsIndeterminate="True"
                                                 IsVisible="{Binding History.IsLoadingChangelogs}"
                                                 Height="4"/>

                                    <!-- Download progress -->
                                    <Border IsVisible="{Binding History.IsDownloading}"
                                            Background="{DynamicResource SurfaceElevatedBrush}" Padding="12" CornerRadius="6">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{DynamicResource Downloading}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                            <ProgressBar Value="{Binding History.DownloadProgress}"
                                                         Minimum="0" Maximum="1"
                                                         Height="6"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Steam auth banner -->
                                    <Border IsVisible="{Binding History.NeedsSteamAuth}"
                                            Background="{DynamicResource SurfaceElevatedBrush}" Padding="14" CornerRadius="8"
                                            BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{DynamicResource SteamAuthRequired}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Command="{Binding History.AuthenticateWithSteamCommand}"
                                                    Background="{DynamicResource AccentPrimaryGradientBrush}"
                                                    Foreground="White" FontWeight="SemiBold"
                                                    BorderThickness="0" CornerRadius="6"
                                                    Padding="12,6" FontSize="12"
                                                    Content="{DynamicResource SteamAuthButton}"
                                                    IsVisible="{Binding !History.IsAuthenticating}"/>
                                        </Grid>
                                    </Border>

                                    <!-- QR code overlay -->
                                    <Border IsVisible="{Binding History.IsAuthenticating}"
                                            Background="{DynamicResource SurfaceElevatedBrush}" Padding="24" CornerRadius="8"
                                            BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center" Spacing="16">
                                            <TextBlock Text="{DynamicResource SteamAuthScanQR}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                            <Border Background="White" Padding="8" CornerRadius="8"
                                                    HorizontalAlignment="Center"
                                                    IsVisible="{Binding History.QrCodeImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <Image Source="{Binding History.QrCodeImage}"
                                                       Width="200" Height="200"
                                                       RenderOptions.BitmapInterpolationMode="None"/>
                                            </Border>
                                            <ProgressBar IsIndeterminate="True" Width="120" HorizontalAlignment="Center"
                                                         IsVisible="{Binding History.QrCodeImage, Converter={x:Static ObjectConverters.IsNull}}"/>
                                            <Button Command="{Binding History.CancelAuthCommand}"
                                                    Background="{DynamicResource SurfaceOverlayBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    CornerRadius="6" Padding="12,6" FontSize="12"
                                                    Content="{DynamicResource SteamAuthCancel}"
                                                    HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Empty state -->
                                    <TextBlock Text="{DynamicResource NoChangelogs}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Margin="0,20"
                                               IsVisible="{Binding !History.ChangeLogHistory.Count}"/>

                                    <!-- Changelog entries -->
                                    <ItemsControl ItemsSource="{Binding History.ChangeLogHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:ChangeLogEntry">
                                                <Border Background="{DynamicResource SurfaceElevatedBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="14"
                                                        Margin="0,0,0,8">
                                                    <StackPanel Spacing="8">
                                                        <!-- Date + Manifest row -->
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                                <TextBlock Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
                                                                <TextBlock Text="{Binding ManifestId}"
                                                                           Foreground="{DynamicResource TextDisabledBrush}"
                                                                           FontFamily="Consolas, Menlo, monospace"
                                                                           FontSize="11"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="200"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="1"
                                                                    Background="#1F5EC384" Padding="8,4" CornerRadius="4"
                                                                    BorderBrush="{DynamicResource FeedbackSuccessBrush}" BorderThickness="1"
                                                                    IsVisible="{Binding IsDownloaded}">
                                                                <TextBlock Text="{DynamicResource AlreadyDownloaded}"
                                                                           Foreground="{DynamicResource FeedbackSuccessTextBrush}" FontSize="11"/>
                                                            </Border>
                                                        </Grid>

                                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                                    IsVisible="{Binding HasBranches}">
                                                            <TextBlock Text="{DynamicResource BranchLabel}" Foreground="{DynamicResource TextDisabledBrush}" FontSize="11"/>
                                                            <TextBlock Text="{Binding SnapshotGameBranchMin}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                                            <TextBlock Text="-" Foreground="{DynamicResource TextDisabledBrush}" FontSize="11"/>
                                                            <TextBlock Text="{Binding SnapshotGameBranchMax}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                                        </StackPanel>

                                                        <TextBox Text="{Binding ChangeDescription, Mode=OneWay}"
                                                                 IsReadOnly="True"
                                                                 TextWrapping="Wrap"
                                                                 MaxHeight="200"
                                                                 Background="{DynamicResource SurfaceCardBrush}"
                                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                                 FontSize="12"
                                                                 Padding="8"
                                                                 CornerRadius="4"/>

                                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                            <Button Command="{Binding $parent[UserControl].((vm:ItemEditorViewModel)DataContext).History.DownloadVersionCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="{DynamicResource AccentPrimaryGradientBrush}"
                                                                    Foreground="White" FontWeight="SemiBold"
                                                                    BorderThickness="0" CornerRadius="6"
                                                                    Padding="12,6" FontSize="12"
                                                                    Content="{DynamicResource DownloadVersion}"
                                                                    IsVisible="{Binding !IsDownloaded}"
                                                                    IsEnabled="{Binding HasManifestId}"/>
                                                            <Button Command="{Binding $parent[UserControl].((vm:ItemEditorViewModel)DataContext).History.OpenVersionFolderCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="{DynamicResource SurfaceOverlayBrush}"
                                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                                    BorderThickness="1"
                                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                                    CornerRadius="6" Padding="12,6" FontSize="12"
                                                                    Content="{DynamicResource OpenFolder}"
                                                                    IsVisible="{Binding IsDownloaded}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding IsDependenciesActive}">
                    <StackPanel Spacing="14" Margin="0,20">

                        <!-- Panel header -->
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Classes="panel-title" Text="{DynamicResource DependenciesHeader}"/>
                            <TextBlock Classes="panel-sub" Text="{DynamicResource DependenciesHeaderSub}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <sections:DependenciesView DataContext="{Binding Dependencies}"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding IsPreviewsActive}">
                    <StackPanel Spacing="14" Margin="0,20">

                        <!-- Panel header -->
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Classes="panel-title" Text="{DynamicResource PreviewsHeader}"/>
                            <TextBlock Classes="panel-sub" Text="{DynamicResource PreviewsHeaderSub}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <sections:PreviewGalleryView DataContext="{Binding Gallery}" ShowPendingUpload="True"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer IsVisible="{Binding IsTranslationsActive}">
                    <StackPanel Spacing="14" Margin="0,20" IsEnabled="{Binding !IsSaving}">

                        <!-- Panel header -->
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Classes="panel-title" Text="{DynamicResource TranslationsHeader}"/>
                            <TextBlock Classes="panel-sub" Text="{DynamicResource TranslationsHeaderSub}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <sections:TranslationsView DataContext="{Binding Translations}"
                                           BaseTitle="{Binding $parent[UserControl].((vm:ItemEditorViewModel)DataContext).Title}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1">
        <!-- Uploaded but hidden on Steam until the account accepts the Workshop legal agreement -->
        <Border IsVisible="{Binding NeedsLegalAgreement}"
                Background="#1FC23B2E" Padding="16" Margin="24,0,24,16" CornerRadius="8"
                BorderBrush="{DynamicResource FeedbackDangerBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <icons:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18"
                                    Foreground="{DynamicResource FeedbackDangerBrush}"
                                    VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Margin="12,0" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="{DynamicResource WorkshopLegalAgreementRequired}"
                           Foreground="{DynamicResource FeedbackDangerTextBrush}"/>
                <Button Grid.Column="2" Command="{Binding OpenLegalAgreementCommand}"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        CornerRadius="6" Padding="12,6" FontSize="13">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{DynamicResource WorkshopLegalAgreementOpen}" VerticalAlignment="Center"/>
                        <icons:MaterialIcon Kind="OpenInNew" Width="11" Height="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Error message -->
        <Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="#1FC23B2E" Padding="16" Margin="24,0,24,16" CornerRadius="8"
                BorderBrush="{DynamicResource FeedbackDangerBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <icons:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18"
                                    Foreground="{DynamicResource FeedbackDangerBrush}"
                                    VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource FeedbackDangerTextBrush}"/>
            </StackPanel>
        </Border>
        </StackPanel>

        <!-- Delete confirmation overlay -->
        <Border Grid.RowSpan="2"
                IsVisible="{Binding ShowDeleteConfirmation}"
                Background="#CC000000">
            <Border Background="{DynamicResource SurfaceOverlayBrush}"
                    Padding="28" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="400"
                    BoxShadow="{StaticResource ToastShadow}">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource ConfirmDelete}"
                                   FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="14">
                            <Run Text="{DynamicResource DeleteConfirmMessage}"/>
                            <Run Text="{Binding Title}" FontWeight="SemiBold" Foreground="White"/>
                            <Run Text="?"/>
                        </TextBlock>
                    </StackPanel>
                    <Border Background="#1FC23B2E" Padding="12" CornerRadius="6"
                            BorderBrush="{DynamicResource FeedbackDangerBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <icons:MaterialIcon Kind="AlertCircleOutline" Width="14" Height="14"
                                                Foreground="{DynamicResource FeedbackDangerTextBrush}"
                                                VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource DeleteWarning}"
                                       Foreground="{DynamicResource FeedbackDangerTextBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{DynamicResource DeleteTypeToConfirm}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"/>
                        <TextBox Text="{Binding DeleteTypedConfirmation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{x:Static helpers:DangerousActions.ConfirmationPassphrase}"
                                 FontFamily="Consolas, Menlo, monospace"
                                 IsEnabled="{Binding !IsDeleting}"/>
                        <TextBlock Text="{DynamicResource DeleteTypeToConfirmHint}"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   FontSize="11"
                                   IsVisible="{Binding !IsDeleteConfirmed}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <Button Command="{Binding CancelDeleteCommand}"
                                Classes="secondary"
                                Content="{DynamicResource Cancel}"
                                IsEnabled="{Binding !IsDeleting}"/>
                        <Button Command="{Binding ConfirmDeleteCommand}"
                                Classes="danger"
                                Content="{DynamicResource DeletePermanently}"
                                IsEnabled="{Binding IsDeleteConfirmed}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
