<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             x:Class="WorkshopManager.App"
             xmlns:local="using:WorkshopManager"
             xmlns:controls="using:WorkshopManager.Views.Controls"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Default language - English (will be swapped at runtime if user changes) -->
                <ResourceInclude Source="avares://WorkshopManager/Resources/Languages/en-US.axaml"/>
                <!-- Semantic theme tokens: Surface/Border/Text/Accent/Feedback + gradients -->
                <ResourceInclude Source="avares://WorkshopManager/Themes/SemanticTokens.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Legacy colors still used by the global styles below -->
            <Color x:Key="WorkshopLightBlue">#66c0f4</Color>
            <Color x:Key="WorkshopLightGray">#c7d5e0</Color>

            <SolidColorBrush x:Key="WorkshopLightBlueBrush" Color="{StaticResource WorkshopLightBlue}"/>
            <SolidColorBrush x:Key="WorkshopLightGrayBrush" Color="{StaticResource WorkshopLightGray}"/>

            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#5c7e10" Offset="0"/>
                <GradientStop Color="#a4d007" Offset="1"/>
            </LinearGradientBrush>

            <BoxShadows x:Key="ToastShadow">0 8 32 0 #80000000</BoxShadows>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <materialIcons:MaterialIconStyles />

        <!-- Global cursor for interactive controls - skip disabled state -->
        <Style Selector="Button:not(:disabled)">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleButton:not(:disabled)">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleSwitch:not(:disabled)">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBoxItem:not(:disabled)">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ComboBoxItem:not(:disabled)">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="RadioButton:not(:disabled)">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="CheckBox:not(:disabled)">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- A button label too long for its button scrolls instead of being cut -->
        <Style Selector="Button">
            <Setter Property="controls:Marquee.AutoWrap" Value="True"/>
        </Style>

        <!-- Primary action button style -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#6d9211" Offset="0"/>
                        <GradientStop Color="#b5e108" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button style -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#3a4a5a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4a5a6a"/>
        </Style>

        <!-- Ghost button style -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource WorkshopLightGrayBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#20FFFFFF"/>
        </Style>

        <!-- Danger button style -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#c23b2e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#d44b3e"/>
        </Style>

        <!-- Reusable drop zone (paired with behaviors:DropZone.Accepts). The
             dashed outline is a Rectangle since Border has no dash support; the
             :dragover pseudo-class (toggled by the behavior) recolors it. -->
        <Style Selector="ContentControl.dropzone">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Rectangle RadiusX="10" RadiusY="10"
                                   StrokeThickness="1.5"
                                   StrokeDashArray="4,3"
                                   Stroke="{DynamicResource BorderStrongBrush}"
                                   Fill="Transparent">
                            <Rectangle.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Stroke" Duration="0:0:0.15"/>
                                    <BrushTransition Property="Fill" Duration="0:0:0.15"/>
                                </Transitions>
                            </Rectangle.Transitions>
                        </Rectangle>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ContentControl.dropzone:dragover /template/ Rectangle">
            <Setter Property="Stroke" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="Fill" Value="#1F66C0F4"/>
        </Style>

        <!-- Mod card badge while its cached data is checked against Steam.
             The animation only runs on .active badges, which are the visible ones. -->
        <Style Selector="Border.refresh-badge">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#C0101418"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="8,0,0,8"/>
        </Style>
        <Style Selector="Border.refresh-badge materialIcons|MaterialIcon">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.refresh-badge.active materialIcons|MaterialIcon">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Improved TextBox -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#1e2328"/>
            <Setter Property="BorderBrush" Value="#3a4a5a"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource WorkshopLightBlueBrush}"/>
        </Style>

        <!-- Improved ComboBox -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#1e2328"/>
            <Setter Property="BorderBrush" Value="#3a4a5a"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </Application.Styles>
</Application>