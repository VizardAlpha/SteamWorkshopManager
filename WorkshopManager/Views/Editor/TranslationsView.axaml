<!-- Per-language title and description shared by the Steam create and edit views. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editor="using:WorkshopManager.ViewModels.Editor"
             xmlns:sections="using:WorkshopManager.Views.Editor"
             xmlns:workshop="using:WorkshopManager.Core.Workshop"
             xmlns:controls="using:WorkshopManager.Views.Controls"
             xmlns:icons="using:Material.Icons.Avalonia"
             x:Class="WorkshopManager.Views.Editor.TranslationsView"
             x:DataType="editor:TranslationEditorViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://WorkshopManager/Themes/EditorStyles.axaml"/>
    </UserControl.Styles>

    <StackPanel Spacing="14">

        <!-- Scan progress: one short query per language -->
        <StackPanel Spacing="6" IsVisible="{Binding IsScanning}">
            <TextBlock Classes="card-meta">
                <Run Text="{DynamicResource TranslationsScanning}"/>
                <Run Text="{Binding ScannedCount}"/><Run Text="/"/><Run Text="{Binding ScanTotal}"/>
            </TextBlock>
            <ProgressBar Minimum="0" Height="4"
                         Maximum="{Binding ScanTotal}"
                         Value="{Binding ScannedCount}"/>
        </StackPanel>

        <Border IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="#1FC23B2E" Padding="8" CornerRadius="4"
                BorderBrush="{DynamicResource FeedbackDangerBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <icons:MaterialIcon Kind="AlertCircleOutline" Width="14" Height="14"
                                    Foreground="{DynamicResource FeedbackDangerTextBrush}"
                                    VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap"
                           Foreground="{DynamicResource FeedbackDangerTextBrush}" FontSize="12"/>
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="240,*">

            <!-- ── Card: Languages ── -->
            <Border Grid.Column="0" Classes="section-card" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="16,14,16,12" ColumnDefinitions="*,Auto">
                        <TextBlock Classes="card-title" Text="{DynamicResource TranslationsLanguages}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Classes="card-meta"
                                   Text="{Binding TranslatedCount}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderSubtleBrush}"/>
                    <StackPanel Margin="8" Spacing="4">
                        <!-- Base language: edited in the Info section -->
                        <StackPanel Margin="10,6">
                            <TextBlock Text="{Binding BaseLanguage.NativeName}"
                                       FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource TranslationsBaseHint}"
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>

                        <ListBox ItemsSource="{Binding Entries}"
                                 SelectedItem="{Binding Selected}"
                                 Background="Transparent">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="editor:TranslationEntryViewModel">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Text="{Binding Language.NativeName}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <!-- Blank on Steam: visitors in this language see nothing -->
                                        <icons:MaterialIcon Grid.Column="1" Kind="AlertCircleOutline"
                                                            Width="14" Height="14" Margin="8,0,0,0"
                                                            Foreground="{DynamicResource FeedbackDangerTextBrush}"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding IsEmptyOnSteam}"/>
                                        <!-- Unsent changes -->
                                        <Ellipse Grid.Column="2" Width="8" Height="8"
                                                 Margin="8,0,0,0"
                                                 Fill="{DynamicResource AccentPrimaryBrush}"
                                                 VerticalAlignment="Center"
                                                 IsVisible="{Binding IsDirty}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{DynamicResource TranslationsEmpty}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Margin="10,4">
                            <TextBlock.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="!HasEntries"/>
                                    <Binding Path="!IsScanning"/>
                                </MultiBinding>
                            </TextBlock.IsVisible>
                        </TextBlock>

                        <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                  SelectedItem="{Binding LanguageToAdd}"
                                  PlaceholderText="{DynamicResource AddLanguage}"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,6,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="workshop:SteamLanguage">
                                    <TextBlock Text="{Binding NativeName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Card: Selected language ── -->
            <Border Grid.Column="1" Classes="section-card" Margin="16,0,0,0" VerticalAlignment="Top">
                <Panel>
                    <TextBlock Text="{DynamicResource TranslationSelectHint}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12" TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="24,32"
                               IsVisible="{Binding !HasSelection}"/>

                    <StackPanel IsVisible="{Binding HasSelection}">
                        <Grid Margin="16,14,16,12" ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="card-title" Text="{Binding Selected.Language.NativeName, FallbackValue=''}"/>
                                <TextBlock Classes="card-meta"
                                           Text="{DynamicResource TranslationModified}"
                                           Foreground="{DynamicResource AccentPrimaryBrush}">
                                    <TextBlock.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="Selected.IsDirty"/>
                                            <Binding Path="IsAttached"/>
                                        </MultiBinding>
                                    </TextBlock.IsVisible>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Command="{Binding CopyBaseCommand}"
                                        IsEnabled="{Binding Selected.IsEditable, FallbackValue=False}"
                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        CornerRadius="6" Padding="10,5" FontSize="12">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <icons:MaterialIcon Kind="ContentCopy" Width="12" Height="12"/>
                                        <TextBlock Text="{DynamicResource CopyBaseText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- Only a language never sent: Steam cannot delete a translation -->
                                <Button Command="{Binding RemoveCommand}"
                                        CommandParameter="{Binding Selected}"
                                        IsVisible="{Binding !Selected.ExistsOnSteam, FallbackValue=False}"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        Foreground="{DynamicResource FeedbackDangerTextBrush}"
                                        CornerRadius="6" Padding="10,5" FontSize="12">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <icons:MaterialIcon Kind="TrashCanOutline" Width="12" Height="12"/>
                                        <TextBlock Text="{DynamicResource RemoveTranslation}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}"/>

                        <StackPanel Margin="16" Spacing="16">
                            <Border IsVisible="{Binding Selected.IsEmptyOnSteam, FallbackValue=False}"
                                    Background="#1FC23B2E" Padding="8" CornerRadius="4"
                                    BorderBrush="{DynamicResource FeedbackDangerBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <icons:MaterialIcon Kind="AlertCircleOutline" Width="14" Height="14"
                                                        Foreground="{DynamicResource FeedbackDangerTextBrush}"
                                                        VerticalAlignment="Top"/>
                                    <TextBlock Text="{DynamicResource TranslationEmptyOnSteam}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource FeedbackDangerTextBrush}" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="6" IsVisible="{Binding Selected.IsLoading, FallbackValue=False}">
                                <TextBlock Classes="card-meta" Text="{DynamicResource TranslationLoading}"/>
                                <ProgressBar IsIndeterminate="True" Height="4"/>
                            </StackPanel>

                            <StackPanel Spacing="16" IsEnabled="{Binding Selected.IsEditable, FallbackValue=False}">
                                <StackPanel>
                                    <TextBlock Classes="field-label" Text="{DynamicResource Title}"/>
                                    <!-- The base title as placeholder: it is what an empty field falls back to -->
                                    <TextBox Text="{Binding Selected.Title, FallbackValue=''}" MaxLength="128"
                                             PlaceholderText="{Binding $parent[sections:TranslationsView].BaseTitle}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Classes="field-label" Text="{DynamicResource Description}"/>
                                    <controls:MarkupEditorControl Text="{Binding Selected.Description, FallbackValue=''}"
                                                                  EditorHeight="200"
                                                                  PlaceholderText="{DynamicResource DescriptionPlaceholder}"/>
                                </StackPanel>
                                <TextBlock Classes="card-meta" Text="{DynamicResource TranslationFallbackHint}"/>
                                <TextBlock Classes="card-meta" TextWrapping="Wrap"
                                           Text="{DynamicResource TranslationCannotDelete}"
                                           IsVisible="{Binding Selected.ExistsOnSteam, FallbackValue=False}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Panel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
